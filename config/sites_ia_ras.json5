{
  api_base_url: "https://archaeolog.ru/api/map",
  default_grouping: "t",
  empty_tile_byte_length: 2390,
  geojson_metadata_filename: "config/oanmap_geojson_metadata.json",
  global_grid_tiles_z8: 128,
  http_concurrency: 6,
  http_retries: 4,
  http_timeout_ms: 20000,
  include_all_periods_geojson: false,
  include_all_periods_mosaic: false,
  kriging_metadata_filename: "config/oanmap_kriging_metadata.json",
  metadata_filename: "config/oanmap_mosaic_metadata.json",
  output_geojson_subfolder: "geojson",
  output_images_subfolder: "images",
  output_kriged_rasters_subfolder: "1.kriged_rasters",
  output_population_rasters_subfolder: "2.population_rasters",
  png_compression_level: 6,
  tile_dilation_radius: 1,
  tile_size_px: 512,
  zoom_level: 8,

  // Geographic mask, Empirical Non-Stationary Ordinary Kriging & Substrata Anchoring configuration
  // Encompasses only the land area of the modern Russian Federation (excluding Kaliningrad),
  // while adding in Crimea (Republic of Crimea + Sevastopol), with a strict 1900 AD cutoff.
  kriging_config: {
    coastal_bfs_max_distance_px: 8,
    covariate_paths: {
      forest_asc: "histmap/1.data_raw/metadata_HYDE/general_files/forest_wwf_cr.asc",
      hyde_mcevedy_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_mcevedy",
      hyde_popc_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters_scaled_to_global",
      hyde_raw_rasters_folder: "histmap/2.data_cleaning/landuse_HYDE/rasters",
      hyde_uopp_raster: "histmap/2.data_cleaning/landuse_HYDE/rasters/uopp_2023AD.png",
      kk10_fallback_folder: "histmap/2.data_cleaning/population_KK10LUH2/rasters_KK10LUH2_2._global_scaling",
      maxln_asc: "histmap/1.data_raw/metadata_HYDE/general_files/maxln_cr.asc",
      nelson_regions_png: "histmap/2.data_cleaning/population_KK10LUH2/config/nelson_regions.png",
      sub_iso_asc: "histmap/1.data_raw/metadata_HYDE/general_files/sub_iso_cr.asc",
      urban_mask_buffer_radius: 1,
      urban_mask_inpaint_radius: 4,
      urban_outlier_spike_ratio: 8.0,
      urban_uopp_threshold: 10.0
    },
    crimea_bbox: {
      max_lat: 46.23,
      max_lon: 36.66,
      min_lat: 44.35,
      min_lon: 32.45,
      peninsula_interior_max_lat: 45.90
    },
    crimea_oblast_ids: [5319, 5346],
    cshapes_crimea_gwcode: 365,
    cshapes_crimea_gweyear: 2019,
    dimensionless_lag_bins: [0.75, 1.25, 1.85, 2.60, 3.60, 5.00, 7.00, 9.50, 13.00, 18.00],
    earth_radius_km: 6371,
    excluded_oblast_ids: [1217],
    grid_height: 2160,
    grid_width: 4320,
    kaliningrad_bbox: {
      max_lat: 56.5,
      max_lon: 25.0,
      min_lat: 53.0,
      min_lon: 18.0
    },
    russia_geocode_rgb: [20, 114, 30],

    // Chronological horizons defined by IA RAS documented period boundaries (-10000 to 1900 AD).
    // Active periods at each horizon are summed directly in their empirical site-count units.
    chronological_horizons: [
      {
        active_periods: ["stone_age"],
        key: "early_stone_age_horizon",
        year: -10000
      },
      {
        active_periods: ["stone_age", "eneolithic"],
        key: "eneolithic_onset_horizon",
        year: -4500
      },
      {
        active_periods: ["eneolithic", "bronze_age", "palaeometal", "early_metal_age"],
        key: "early_bronze_transition_horizon",
        year: -3000
      },
      {
        active_periods: ["bronze_age", "palaeometal", "early_metal_age"],
        key: "middle_bronze_horizon",
        year: -1500
      },
      {
        active_periods: ["iron_age", "classical_antiquity", "palaeometal", "early_metal_age"],
        key: "early_iron_classical_horizon",
        year: -500
      },
      {
        active_periods: ["iron_age", "classical_antiquity"],
        key: "late_iron_classical_horizon",
        year: 0
      },
      {
        active_periods: ["iron_age", "classical_antiquity", "migration_period", "middle_ages"],
        key: "migration_onset_horizon",
        year: 400
      },
      {
        active_periods: ["migration_period", "middle_ages"],
        key: "early_medieval_transition_horizon",
        year: 700
      },
      {
        active_periods: ["middle_ages"],
        key: "high_middle_ages_horizon",
        year: 1000
      },
      {
        active_periods: ["middle_ages", "early_modern_17_18c"],
        key: "early_modern_onset_horizon",
        year: 1600
      },
      {
        active_periods: ["middle_ages", "early_modern_17_18c", "modern"],
        key: "modern_onset_horizon",
        year: 1800
      },
      {
        active_periods: ["middle_ages", "early_modern_17_18c", "modern"],
        key: "late_imperial_1900_horizon",
        year: 1900
      }
    ],

    // 48 HYDE benchmark years up to the 1900 AD cutoff
    hyde_years: [
      -10000, -9000, -8000, -7000, -6000, -5000, -4000, -3000, -2000, -1000,
      0, 100, 200, 300, 400, 500, 600, 700, 800, 900,
      1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700,
      1710, 1720, 1730, 1740, 1750, 1760, 1770, 1780, 1790,
      1800, 1810, 1820, 1830, 1840, 1850, 1860, 1870, 1880, 1890,
      1900
    ]
  },

  // Canonical zoom-8 512px tile extent covering all IA RAS sites from Kaliningrad (x=70, 16.875E)
  // continuously across 180E into Eastern Chukotka (unwrapped x=131 -> tile x=3, 191.25E / 168.75W),
  // and from Arctic Taymyr (y=24, 75.845N) to Southern Dagestan (y=48, 38.823N).
  mosaic_bounds_z8: {
    max_tile_y: 48,
    max_unwrapped_x: 131,
    min_tile_y: 24,
    min_unwrapped_x: 70
  },

  // Chronological periods exposed in the OANMAP Epoch filter (all site types selected)
  periods: [
    {
      approx_end_year: -3000,
      approx_start_year: -2600000,
      date_range_en: "c. 2,6M–3000 BC (to c. 1500 BC in northern taiga/Siberia)",
      epoch_id: 52,
      filename: "01_stone_age_e52.png",
      geojson_filename: "01_stone_age_e52.geojson",
      key: "stone_age",
      name_de: "Steinzeit",
      name_en: "Stone Age",
      name_fr: "Âge de la pierre",
      name_ru: "Каменный Век"
    },
    {
      approx_end_year: -3000,
      approx_start_year: -4500,
      date_range_en: "c. 4500–3000 BC (to c. 2000 BC in forest-steppe/Urals/W. Siberia)",
      epoch_id: 13,
      filename: "02_eneolithic_e13.png",
      geojson_filename: "02_eneolithic_e13.geojson",
      key: "eneolithic",
      name_de: "Äneolithikum (Kupfersteinzeit)",
      name_en: "Eneolithic",
      name_fr: "Énéolithique",
      name_ru: "Энеолит"
    },
    {
      approx_end_year: -300,
      approx_start_year: -3000,
      date_range_en: "c. 3000–300 BC (c. 1500 BC–300 AD in Russian Far East/Siberia)",
      epoch_id: 22,
      filename: "03_palaeometal_e22.png",
      geojson_filename: "03_palaeometal_e22.geojson",
      key: "palaeometal",
      name_de: "Paläometallzeit",
      name_en: "Palaeometal Period",
      name_fr: "Âge paléométallique",
      name_ru: "Палеометалл"
    },
    {
      approx_end_year: -500,
      approx_start_year: -3500,
      date_range_en: "c. 3500–500 BC (northern forest/taiga Karelia, Kola and NE Siberia)",
      epoch_id: 21,
      filename: "04_early_metal_age_e21.png",
      geojson_filename: "04_early_metal_age_e21.geojson",
      key: "early_metal_age",
      name_de: "Frühe Metallzeit",
      name_en: "Early Metal Age",
      name_fr: "Âge des métaux anciens",
      name_ru: "Эпоха Раннего Металла"
    },
    {
      approx_end_year: -800,
      approx_start_year: -3300,
      date_range_en: "c. 3300–800 BC (4th–early 1st millennia BC)",
      epoch_id: 47,
      filename: "05_bronze_age_e47.png",
      geojson_filename: "05_bronze_age_e47.geojson",
      key: "bronze_age",
      name_de: "Bronzezeit",
      name_en: "Bronze Age",
      name_fr: "Âge du bronze",
      name_ru: "Бронзовый Век"
    },
    {
      approx_end_year: 400,
      approx_start_year: -800,
      date_range_en: "c. 800 BC–400 AD (to c. 500–700 AD in forest zone/Siberia)",
      epoch_id: 36,
      filename: "06_iron_age_e36.png",
      geojson_filename: "06_iron_age_e36.geojson",
      key: "iron_age",
      name_de: "Eisenzeit",
      name_en: "Iron Age",
      name_fr: "Âge du fer",
      name_ru: "Железный век"
    },
    {
      approx_end_year: 400,
      approx_start_year: -600,
      date_range_en: "c. 600 BC–400 AD (Northern Black Sea/Crimea/Taman/Lower Don)",
      epoch_id: 6,
      filename: "07_classical_antiquity_e6.png",
      geojson_filename: "07_classical_antiquity_e6.geojson",
      key: "classical_antiquity",
      name_de: "Antike",
      name_en: "Classical Antiquity",
      name_fr: "Antiquité classique",
      name_ru: "Античное Время"
    },
    {
      approx_end_year: 700,
      approx_start_year: 350,
      date_range_en: "c. 350–700 AD (late 4th–7th c. AD)",
      epoch_id: 34,
      filename: "08_migration_period_e34.png",
      geojson_filename: "08_migration_period_e34.geojson",
      key: "migration_period",
      name_de: "Völkerwanderungszeit",
      name_en: "Migration Period",
      name_fr: "Période des grandes migrations",
      name_ru: "Эпоха Великого переселения народов"
    },
    {
      approx_end_year: 1600,
      approx_start_year: 400,
      date_range_en: "c. 400–1600 AD (5th–16th c. AD)",
      epoch_id: 37,
      filename: "09_middle_ages_e37.png",
      geojson_filename: "09_middle_ages_e37.geojson",
      key: "middle_ages",
      name_de: "Mittelalter",
      name_en: "Middle Ages",
      name_fr: "Moyen Âge",
      name_ru: "Эпоха Средневековья"
    },
    {
      approx_end_year: 1800,
      approx_start_year: 1600,
      date_range_en: "1600–1800 AD (17th–18th c. AD)",
      epoch_id: 3,
      filename: "10_early_modern_17_18c_e3.png",
      geojson_filename: "10_early_modern_17_18c_e3.geojson",
      key: "early_modern_17_18c",
      name_de: "Frühe Neuzeit (17.–18. Jh.)",
      name_en: "Early Modern Period (17th–18th c.)",
      name_fr: "Époque moderne (XVIIe–XVIIIe s.)",
      name_ru: "Новое Время (17-18 вв.)"
    },
    {
      approx_end_year: 1925,
      approx_start_year: 1800,
      date_range_en: "1800–c. 1925 AD (19th–early 20th c. AD; >100 years old per 73-FZ)",
      epoch_id: 18,
      filename: "11_modern_e18.png",
      geojson_filename: "11_modern_e18.geojson",
      key: "modern",
      name_de: "Neueste Zeit",
      name_en: "Contemporary Period",
      name_fr: "Époque contemporaine",
      name_ru: "Новейшее время"
    },
    {
      approx_end_year: null,
      approx_start_year: null,
      date_range_en: "Undated / Unspecified",
      epoch_id: -1,
      filename: "12_unspecified_e_neg1.png",
      geojson_filename: "12_unspecified_e_neg1.geojson",
      key: "unspecified",
      name_de: "Nicht angegeben",
      name_en: "Unspecified Period",
      name_fr: "Période non précisée",
      name_ru: "Не указано"
    }
  ]
}
